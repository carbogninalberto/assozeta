{
  "about": "Parity harnesses for ledger entries that have no HTTP-family fixture or *_process.py harness. Commands are the ones go-quality.yml (or the entry's recorded evidence) runs. run_components.py executes them; promote_verified.py credits an entry only when every component listed for it passed. {python} is the migration interpreter; {out} is the run's receipt directory.",
  "components": {
    "audit-index": {
      "commands": [
        {
          "argv": [
            "{python}",
            "-m",
            "TESTS.adapters.go.audit_index",
            "{label}"
          ],
          "receipt": "quality-reports/go-migration/audit-index-{label}/results.json",
          "check": "json-success"
        }
      ],
      "entries": [
        "command:BE/application/management/commands/backfill_audit_log_index.py:backfill_audit_log_index",
        "signal_connection:BE/application/signals.py:post_save.connect:create_audit_log_index"
      ]
    },
