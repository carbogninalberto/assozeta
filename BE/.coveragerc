[run]
source =
    application
    instance
    communications
    notifications
    core
    docmanager
branch = True
omit =
    */migrations/*
    */tests/*
    */__pycache__/*
    core/wsgi.py
    core/asgi.py

[report]
show_missing = True
precision = 2
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    class .*\bProtocol\):
    @(abc\.)?abstractmethod
