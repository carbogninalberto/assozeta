# Reference for the file generated by `make dev-config` or `make dev`.
# Do not copy this file over selfhost/.env.dev: the command creates all required
# secrets and service settings automatically.
#
# INSTANCE_SETUP_TOKEN is not user-defined. In the generated .env.dev, copy its
# exact value into the setup wizard. The placeholder below is not a valid token.
# Optional integrations may remain blank. DEV_* ports and VITE_USE_POLLING are
# the normal settings to customize for a local workstation.
COMPOSE_PROJECT_NAME=assozeta-dev
DEBUG=True
SITE_ADDRESS=http://localhost:5001
APP_URL=http://localhost:5001
APP_HOST=localhost:5001
ACME_EMAIL=localhost@example.invalid
INSTANCE_SETUP_TOKEN=replace-me
ALLOWED_HOSTS=localhost,127.0.0.1,api
CORS_ORIGIN_ALLOW_ALL=True
CSRF_TRUSTED_ORIGINS=http://localhost:5001,http://localhost:8000
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# All remaining backend, database, Redis, MinIO, renderer, and optional
# integration values are generated by ./selfhost/bin/assozeta dev-config.
