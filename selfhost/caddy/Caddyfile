{
    email {$ACME_EMAIL:localhost@example.invalid}
}

{$SITE_ADDRESS} {
    encode zstd gzip
    root * /srv

    header {
        -Server
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Content-Type-Options "nosniff"
    }

    handle /healthz {
        respond 200
    }

    handle /instance-update-status {
        reverse_proxy unix//run/assozeta-update-status/status.sock
    }

    handle_path /api/* {
        reverse_proxy api:8000
    }

    handle /ws/* {
        reverse_proxy api:8000
    }

    @ui_static {
        path /static/*
        file
    }

    handle @ui_static {
        header Cache-Control "no-cache"
        file_server
    }

    handle_path /static/* {
        root * /django-static
        header Cache-Control "no-cache"
        file_server
    }

    handle {
        # Revalidate entry HTML and unversioned public assets on full reloads.
        # Compiled JS/CSS also use content hashes in their filenames.
        header Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }
}
