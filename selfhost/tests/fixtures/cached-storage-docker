#!/usr/bin/env python3
"""Use preloaded immutable storage only when an old CLI pulls its dependencies.

No registry mapping and no application-image substitution. This adapter is used
only for initial installation of historical releases that predate the fallback.
"""
import os
import sys
args = sys.argv[1:]
if args and args[0] == 'compose' and args[-1] == 'pull':
    args.extend(['--policy', 'missing'])
real = os.environ['ASSOZETA_REHEARSAL_DOCKER']
os.execv(real, [real, *args])
