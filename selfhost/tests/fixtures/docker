#!/usr/bin/env python3
"""Local registry adapter installed only in disposable integration-test images."""
import json
import os
from pathlib import Path
import subprocess
import sys
import time

REAL = '/usr/local/bin/docker-real'
references = json.loads((Path(os.environ['ASSOZETA_TEST_FIXTURES']) / 'images.json').read_text())
args = [references.get(arg, arg) for arg in sys.argv[1:]]
fixtures = Path(os.environ['ASSOZETA_TEST_FIXTURES'])
# A legacy release cannot select immutable image references in its Compose file.
# Keep its files/environment canonical; substitute local fixture images only in
# this test registry adapter, through a separate image-only Compose override.
if args[0] == 'compose' and '--env-file' in args and (fixtures / 'legacy-images.json').exists():
    environment_file = Path(args[args.index('--env-file') + 1])
    values = dict(line.split('=', 1) for line in environment_file.read_text().splitlines()
                  if '=' in line and not line.startswith('#'))
    if values.get('ASSOZETA_VERSION') == '1.0.2':
        # The canonical composition must be first; image overrides come last.
        index = max(i + 2 for i, value in enumerate(args) if value == '-f')
        args[index:index] = ['-f', str(fixtures / 'legacy-images.json')]
if 'pg_dump' in args and (fixtures / 'fail-backup').exists():
    (fixtures / 'fail-backup').unlink()
    raise SystemExit(24)
if 'pg_restore' in args and (fixtures / 'fail-restore').exists():
    (fixtures / 'fail-restore').unlink()
    raise SystemExit(23)
if 'pg_dump' in args and (fixtures / 'hold-backup').exists():
    (fixtures / 'backup-blocked').write_text('backup reached PostgreSQL snapshot\n')
    while (fixtures / 'hold-backup').exists():
        time.sleep(0.1)


def pull(reference):
    if reference == references['fixture-backend-3'] and (fixtures / 'fail-download').exists():
        (fixtures / 'fail-download').unlink()
        raise SystemExit(25)
    if reference in references.values():
        subprocess.run([REAL, 'image', 'inspect', reference], check=True, stdout=subprocess.DEVNULL)
    else:
        subprocess.run([REAL, 'pull', reference], check=True)


if args[0] == 'pull':
    pull(args[1])
elif args[0] == 'compose' and args[-1] == 'pull':
    images = subprocess.check_output([REAL, *args[:-1], '--profile', 'tools', 'config', '--images'], text=True).splitlines()
    for image in set(images):
        if subprocess.run([REAL, 'image', 'inspect', image], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode:
            pull(image)
else:
    os.execv(REAL, [REAL, *args])
