# Generated by ./selfhost/bin/assozeta configure. Do not commit selfhost/.env.
COMPOSE_PROJECT_NAME=assozeta
ASSOZETA_VERSION=latest
ASSOZETA_BACKEND_IMAGE=ghcr.io/carbogninalberto/assozeta-backend
ASSOZETA_WEB_IMAGE=ghcr.io/carbogninalberto/assozeta-web
ASSOZETA_RENDERER_IMAGE=ghcr.io/carbogninalberto/assozeta-renderer
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_CLIENT_IMAGE=quay.io/minio/mc:RELEASE.2025-04-16T18-13-26Z

SITE_ADDRESS=example.org
APP_URL=https://example.org
APP_HOST=example.org
ACME_EMAIL=admin@example.org
HTTP_PORT=80
HTTPS_PORT=443

SECRET_KEY=replace-me
INSTANCE_SETUP_TOKEN=replace-me
JWT_SECRET_KEY_B64=replace-me
JWT_PUBLIC_KEY_B64=replace-me
DOCUMENT_BYPASS_TOKEN=replace-me
SENJA_WEBHOOK_SECRET=replace-me
CRM_API_TOKEN=replace-me
STRIPE_WEBHOOK_SECRET=replace-me
ADMIN_URL=admin-disabled/

DEBUG=False
RATELIMIT_ENABLE=True
ALLOWED_HOSTS=example.org,api,localhost,127.0.0.1
CORS_ORIGIN_ALLOW_ALL=False
CORS_ALLOWED_ORIGINS=https://example.org
CSRF_TRUSTED_ORIGINS=https://example.org
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
CURRENT_HOST=http://api:8000
GOOGLE_CALENDAR_REDIRECT_URL=https://example.org/api/google/oauth2callback
WHITELABEL_NAME=Assozeta

DBTYPE=POSTGRES
DBNAME=assozeta
DBUSER=assozeta
DBPASSWORD=replace-me
DBHOST=postgres
DBPORT=5432
USE_PGBOUNCER=False

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=replace-me

STORE_ON_DISK=False
AWS_ACCESS_KEY_ID=assozeta
AWS_SECRET_ACCESS_KEY=replace-me
AWS_STORAGE_BUCKET_NAME=assozeta
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_LOCATION=storage
AWS_S3_FILE_OVERWRITE=False
MINIO_ROOT_USER=assozeta
MINIO_ROOT_PASSWORD=replace-me

PUPPETEER_HOST=renderer
PUPPETEER_PORT=3000
CURRENT_HOST_PUPPETEER=http://api:8000

SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=
SOCIAL_AUTH_APPLE_ID_CLIENT=
SOCIAL_AUTH_APPLE_ID_TEAM=
SOCIAL_AUTH_APPLE_ID_KEY=
SOCIAL_AUTH_APPLE_ID_SECRET=
STRIPE_KEY=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_SUPPORT=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
GROQ_API_KEY=
SMSAPI_TOKEN=

WEB_CONCURRENCY=2
CELERY_CONCURRENCY=2
TZ=Europe/Rome
