{
  "format": 1,
  "description": "Maintained classification data for docs/scripts/manuale_impact.py. Rules are matched in order; the first match wins. A pattern ending in '/' or without wildcards is a path prefix; patterns with *, ? or [ use fnmatch (where * also matches '/'). Security and shared-contract rules always fail closed. For every other rule, a file inside a workflow's dependency closure is classified as behavior (or capture-tooling) for exactly those workflows. Paths matched by no rule and outside every closure are unknown and require full verification. Add new top-level areas here explicitly; they are unknown by default.",
  "python": {
    "root": "BE",
    "packages": ["application", "core", "instance", "docmanager", "communications", "notifications"],
    "template_roots": ["BE/templates"],
    "runtime_entries": [
      "BE/manage.py", "BE/core/", "BE/*/apps.py", "BE/*/urls.py", "BE/*/admin.py", "BE/*/tasks.py",
      "BE/*/routing.py", "BE/*/management/commands/*.py", "BE/*/templatetags/*.py", "BE/*/migrations/*.py",
      "BE/*/signals.py", "BE/*/consumers.py", "BE/*/models.py", "BE/*/models/__init__.py",
      "BE/*/asgi.py", "BE/*/wsgi.py"
    ],
    "runtime_entry_exclude": ["BE/*/tests/", "BE/conftest.py"],
    "beat": {"schedule": "BE/core/celery.py", "task_modules": ["BE/*tasks.py"]},
    "security_settings": ["MIDDLEWARE", "AUTHENTICATION", "AUTH_", "PERMISSION", "PASSWORD", "SESSION", "CSRF", "JWT",
                          "TOKEN", "LOGIN", "THROTTLE", "CORS", "CHANNEL"],
    "pure_decorators": ["api_view", "permission_classes", "authentication_classes", "throttle_classes",
                        "renderer_classes", "parser_classes", "shared_task", "contextmanager", "dataclass",
                        "sensitive_variables", "sensitive_post_parameters", "xframe_options_exempt", "require_GET",
                        "require_POST", "require_http_methods", "ratelimit", "lru_cache", "cache", "csrf_exempt",
                        "atomic", "method_decorator", "login_required", "database_sync_to_async", "sync_to_async",
                        "override_settings", "freeze_time", "staticmethod", "classmethod", "property",
                        "cached_property", "wraps"]
  },
  "ui": {
    "root": "UI/src",
    "entry": "UI/src/main.js",
    "aliases": {
      "utils": "UI/src/utils",
      "components": "UI/src/components",
      "store": "UI/src/store",
      "routes": "UI/src/routes",
      "ui": "UI/src/ui",
      "shim": "UI/src/shim"
    },
    "endpoints": "UI/endpoints.js",
    "api_prefix": "/api",
    "root_urlconf": "BE/core/urls.py"
  },
  "hubs": {
    "BE/application/urls.py": {"follow": "none", "reason": "URL table imports every view; routed views must be declared per workflow or found through UI API links."},
    "BE/application/chat/urls.py": {"follow": "none", "reason": "URL table."},
    "BE/communications/urls.py": {"follow": "none", "reason": "URL table."},
    "BE/docmanager/urls.py": {"follow": "none", "reason": "URL table."},
    "BE/instance/urls.py": {"follow": "none", "reason": "URL table."},
    "BE/instance/sso/urls.py": {"follow": "none", "reason": "URL table."},
    "BE/core/urls.py": {"follow": "none", "reason": "Root URL table."},
    "BE/core/settings.py": {"follow": "none", "reason": "Settings name every installed module by string; the file itself is a security input of every workflow. Its imports are not expanded, but every dotted module string it names is a global dependency, and modules named under python.security_settings are security inputs."},
    "BE/core/asgi.py": {"follow": "none", "reason": "Websocket router; the per-page websocket routes are global dependencies, the Bot websocket is not."},
    "docs/scripts/manuale-generate.mjs": {"follow": "none", "reason": "Generator entry point: shared by every workflow itself; the manual modules it loads are classified by their own rules."},
    "UI/src/routes.js": {"follow": "static", "reason": "Route table: static helpers are followed, lazily loaded route components must be declared per workflow."}
  },
  "global_dependencies": [
    {"match": ["BE/core/", "BE/*/apps.py", "BE/*/urls.py", "BE/*/migrations/", "BE/manage.py", "BE/requirements.txt",
               "BE/Dockerfile", "BE/.dockerignore", "BE/entrypoint", "BE/gunicorn_config.py", "BE/release-manual/",
               "BE/application/routing.py", "BE/notifications/routing.py"],
     "reason": "Django runtime, routing, per-page websockets, schema and backend image used by every capture."},
    {"match": ["BE/*/models.py", "BE/*/models/"], "symbols": "module",
     "reason": "Django loads every model module at startup; only module-level code is global, model classes are followed where used."},
    {"match": ["BE/application/management/commands/seed_", "BE/application/management/commands/run_manuale_instance.py"],
     "reason": "Shared capture fixtures."},
    {"match": ["UI/src/main.js", "UI/src/routes.js", "UI/src/routes/dashboard/Dashboard.svelte", "UI/index.html",
               "UI/package.json", "UI/package-lock.json", "UI/vite.config.js", "UI/endpoints.js", "UI/oems.json",
               "UI/use_cdn.js", "UI/postcss.config.cjs", "UI/build.versions", "UI/jsconfig.json", "UI/Dockerfile",
               "UI/.dockerignore", "UI/.npmrc", "UI/Caddyfile", "UI/public/"],
     "reason": "Application shell, landing dashboard opened by every scenario login, frontend build inputs."},
    {"match": ["selfhost/compose.dev.yml", "selfhost/renderer/", "selfhost/config/",
               "selfhost/tests/browser/playwright.manual.config.mjs", "selfhost/tests/browser/package.json",
               "selfhost/tests/browser/package-lock.json", "selfhost/tests/browser/manuale/frame.mjs",
               "selfhost/tests/browser/manuale/redaction.mjs", "docs/scripts/manuale-generate.mjs",
               "manuale/.manuale-authoring.json"],
     "reason": "Capture stack, browser environment and screenshot contracts."}
  ],
  "rules": [
    {"match": ["BE/core/middleware", "BE/core/authentication", "BE/core/jwt_backend", "BE/core/settings",
               "BE/application/impersonation", "BE/application/tenant_scope.py", "BE/application/document_scope.py",
               "BE/application/permissions.py", "BE/application/permissions_registry.py", "BE/application/mixin.py",
               "BE/application/services/jwt_token_service.py", "BE/application/services/social_auth_service.py",
               "BE/application/serializers/auth_serializers.py", "BE/application/views/auth_views.py",
               "BE/application/views/two_fa_views.py", "BE/application/views/admin_views.py",
               "BE/application/mcp_server/security.py", "BE/application/chat/throttling.py",
               "BE/instance/permissions.py", "BE/instance/sso/", "BE/docmanager/download_tokens.py",
               "BE/notifications/middleware.py"],
     "category": "security", "checks": ["mcp", "bot"],
     "reason": "Authentication, authorization, impersonation or tenant-scope code: comprehensive security and runtime checks."},
    {"match": ["BE/application/mcp_server/query_builder.py", "BE/application/mcp_server/server.py",
               "BE/application/mcp_server/attendance.py", "BE/application/mcp_server/exporters/__init__.py",
               "BE/application/chat/consumers.py", "BE/application/chat/views.py", "BE/application/agent/core.py",
               "BE/application/manuale/tools.py", "BE/application/manuale/views.py", "BE/application/manuale/index.py",
               "BE/application/management/commands/run_mcp_server.py",
               "BE/application/management/commands/run_agent.py"],
     "category": "security", "checks": ["mcp", "bot"],
     "reason": "Bot/MCP tenant filter, identity injection, websocket or reader authentication, owner-only manual tools, audience filtering or export field exclusion: comprehensive security and runtime checks."},
    {"match": ["BE/*/tests/test_manuale*", "BE/*/tests/test_agent*", "BE/*/tests/test_ai_provider*", "BE/*/tests/test_mcp*",
               "BE/*/tests/test_chat*"],
     "category": "mcp", "checks": ["bot"],
     "reason": "Backend test of the manual corpus, Bot or MCP: offline manual, Bot and MCP contract checks."},
    {"match": ["TESTS/contracts/test_manual.py", "TESTS/browser/manual-release.mjs", "TESTS/mcp/manual.py",
               ".github/workflows/publish-images.yml"],
     "category": "shared-contract",
     "reason": "Installed-release manual contract or the release/image publication workflow that runs Mode C: release-relevant, full verification and appliance rehearsal."},
    {"match": ["BE/*/tests/", "BE/conftest.py", "BE/pytest.ini", "BE/requirements-test.txt", "BE/.coveragerc"],
     "category": "unrelated", "reason": "Backend test-only file; ordinary backend tests run in their own CI."},
    {"match": ["BE/application/management/commands/seed_", "BE/application/management/commands/run_manuale_instance.py",
               "manuale/.manuale-authoring.json", "docs/manuale/source.json", "docs/manuale/page-map.json",
               "docs/manuale/requirements-offline.txt",
               "selfhost/tests/browser/playwright.manual.config.mjs", "selfhost/tests/browser/package.json",
               "selfhost/tests/browser/package-lock.json", "selfhost/tests/browser/manuale/frame.mjs",
               "selfhost/tests/browser/manuale/redaction.mjs", "selfhost/tests/browser/manuale/compile.mjs",
               "selfhost/tests/browser/manuale/embedded.mjs", "selfhost/tests/browser/manuale/verify.mjs",
               "selfhost/tests/browser/manuale/reader-plan.mjs", "selfhost/tests/manual-release-smoke",
               "docs/manuale/workflow-registry.mjs", "docs/manuale/evidence-contracts.mjs",
               "docs/scripts/manuale.py", "docs/scripts/manuale_impact.py", "docs/scripts/manuale_evidence_store.py",
               "docs/scripts/manuale_timing.py", "docs/scripts/manuale-", "docs/manuale/impact-map.json",
               "BE/application/manuale/publication.py", "BE/application/manuale/render_reuse.py",
               "BE/application/manuale/reuse.py", "BE/application/manuale/sync.py",
               "BE/application/manuale/development.py", "BE/application/manuale/preview.py",
               "BE/application/manuale/bundle.py",
               "BE/application/management/commands/build_manuale_index.py",
               "BE/application/management/commands/sync_manuale_corpus.py",
               "BE/application/management/commands/evaluate_manuale.py",
               "BE/application/management/commands/compare_manuale_captures.py",
               "BE/application/management/commands/install_manuale_",
               ".github/workflows/manuale", ".github/actions/"],
     "category": "shared-contract", "exclude": ["docs/scripts/manuale-generate.mjs"],
     "reason": "Shared fixture, screenshot/browser contract, manual pipeline or publication-gating code: full verification."},
    {"match": ["docs/scripts/manuale-generate.mjs", "docs/manuale/authored-workflows.mjs",
               "docs/manuale/legacy-workflows.mjs"],
     "category": "capture-tooling", "scope": "all",
     "reason": "Capture entry point or workflow aggregation shared by every workflow."},
    {"match": ["docs/manuale/recipes.json"], "category": "capture-tooling", "handler": "recipes-registry",
     "reason": "Generated workflow registry; compared per workflow against the base revision."},
    {"match": ["docs/manuale/*-authored-workflows.mjs"], "category": "capture-tooling",
     "handler": "workflow-definition", "reason": "Workflow definition module."},
    {"match": ["docs/manuale/editorial-contracts.mjs", "docs/manuale/manual-content.mjs",
               "docs/manuale/rendered-content.mjs", "docs/manuale/reference-catalogue.mjs",
               "docs/manuale/authored-reference-recipes.mjs"],
     "category": "docs-text", "handler": "all-pages",
     "reason": "Manual compile/projection contract: recompile and re-verify every page from reused evidence."},
    {"match": ["docs/manuale/*-recipes.mjs"], "category": "docs-text", "handler": "reference-module",
     "reason": "Reviewed prose contract module; affected pages come from manuale/.manuale-evidence.json bindings."},
    {"match": ["docs/manuale/"], "category": "capture-tooling", "scope": "all",
     "exclude": ["docs/manuale/README.md", "docs/manuale/DELIVERY_CHECKLIST.md", "docs/manuale/ci-performance.md"],
     "reason": "Unregistered manual tooling module (fails closed to every workflow). Register it in a recipe or add a rule."},
    {"match": ["docs/manuale/README.md", "docs/manuale/DELIVERY_CHECKLIST.md", "docs/manuale/ci-performance.md"],
     "category": "unrelated", "reason": "Maintainer documentation."},
    {"match": ["manuale/.manuale-evidence.json"], "category": "docs-text", "handler": "evidence-bindings",
     "reason": "Section evidence bindings; affected pages are the changed sections."},
    {"match": ["manuale/_snippets/"], "category": "docs-text", "handler": "manual-snippet",
     "reason": "Shared MDX snippet; affected pages are those that include it."},
    {"match": ["manuale/images/"], "category": "behavior", "handler": "manual-image",
     "reason": "Captured screenshot output changed outside capture."},
    {"match": ["manuale/*.mdx"], "category": "docs-text", "handler": "manual-page",
     "reason": "Manual page text."},
    {"match": ["manuale/mint.json", "manuale/logo/", "manuale/favicon.svg", "manuale/video/"],
     "category": "docs-text", "reason": "Manual navigation or static asset; recompile only."},
    {"match": ["manuale/README.md", "manuale/CLAUDE.md", "manuale/AUTHORING.md", "manuale/SCREENSHOTS-NEEDED.md",
               "manuale/SCREENSHOT-PLACEHOLDERS.html", "manuale/.claude/"],
     "category": "unrelated", "reason": "Authoring guidance; not compiled into the manual."},
    {"match": ["BE/application/agent/", "BE/application/chat/", "BE/application/manuale/answers.py",
               "BE/application/management/commands/run_agent.py"],
     "category": "bot", "reason": "Bot answer/runtime code: Bot contract checks."},
    {"match": ["BE/application/mcp_server/", "BE/application/manuale/tools", "BE/application/management/commands/run_mcp_server.py"],
     "category": "mcp", "reason": "MCP server or manual tool code: MCP contract checks."},
    {"match": ["BE/application/manuale/index.py", "BE/application/manuale/availability.py",
               "BE/application/manuale/views.py", "BE/application/manuale/__init__.py"],
     "category": "mcp", "checks": ["bot"],
     "reason": "Shared verified manual corpus served to reader, Bot and MCP: Bot and MCP contract checks."},
    {"match": ["selfhost/tests/browser/manuale/*.test.mjs"], "category": "unrelated",
     "reason": "Capture tooling unit test; node tests run in every mode."},
    {"match": ["selfhost/tests/browser/manuale/"], "category": "capture-tooling", "scope": "all",
     "reason": "Capture module not imported by any registered workflow (fails closed to every workflow)."},
    {"match": ["selfhost/tests/", "selfhost/bin/", "selfhost/updater/", "selfhost/caddy/", "selfhost/compose.yml",
               "selfhost/compose.updater.yml", "selfhost/*.md", "selfhost/.env.example", "selfhost/.env.dev.example"],
     "category": "unrelated",
     "reason": "Self-host packaging or independent application test, not used by manual captures; covered by self-host CI and release mode."},
    {"match": ["UI/src/*.test.js", "UI/src/*.spec.js", "UI/scripts/test-", "UI/scripts/*.test.js",
               "UI/scripts/verify-", "UI/scripts/legacy-usage-report.js", "UI/scripts/setupTypeScript.js",
               "UI/scripts/dev-container.sh", "UI/scripts/self-instance", "UI/scripts/brand-theme-fixture.mjs",
               "UI/scripts/vendor-bootstrap-css.mjs", "UI/README.md", "UI/LICENSE", "UI/THIRD-PARTY-LICENSES.md",
               "UI/release_notes.txt", "UI/eslint.config.js", "UI/.prettierrc.json", "UI/.prettierignore",
               "UI/.lintstagedrc", "UI/.gitignore", "UI/capacitor.config.json"],
     "category": "unrelated", "reason": "Frontend test, lint or maintainer script outside the bundled application."},
    {"match": ["UI/src/"], "category": "unrelated", "handler": "ui-outside-closures",
     "reason": "Frontend module outside every workflow's import closure (declared route components, app shell and landing dashboard)."},
    {"match": ["docs/scripts/tests/"], "category": "unrelated", "reason": "Manual tooling unit test; unit tests run in every mode."},
    {"match": ["TESTS/", "BE_GO/", "docs/architecture/", "docs/diagrams/", "docs/goal-prompts/", "docs/matrix/",
               "docs/verification/", "docs/contracts/", "docs/img/", "docs/README.md", "docs/ci.md",
               "docs/scripts/README.md", "docs/scripts/analyze_architecture.mjs",
               "docs/scripts/capture_system_screenshots.mjs", "docs/scripts/generate_coverage_gaps.mjs",
               "docs/scripts/generate_docs_summary.mjs", "docs/scripts/render_mermaid_diagrams.mjs",
               "quality-reports/", "skills/", "README.md", "LICENSE", "Makefile", "run_tests.sh", ".gitignore",
               ".gitattributes", ".github/workflows/pull-request-quality.yml",
               ".github/workflows/selfhost-quality.yml", ".github/workflows/selfhost-release-rehearsal.yml",
               ".github/workflows/update-contributors.yml"],
     "category": "unrelated", "reason": "Allow-listed area that is not an input of manual captures, compilation or publication."}
  ]
}
