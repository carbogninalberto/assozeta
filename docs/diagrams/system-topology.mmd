    APIGW --> DOC["BE/docmanager"]
    APIGW --> INST["BE/instance"]
    APPCORE --> PERM["Permission middleware + registry"]
    APPCORE --> TASKS["Celery task dispatcher"]
    APPCORE --> DB[(PostgreSQL)]
    APPCORE --> REDIS[(Redis)]
    APPCORE --> FS["Object storage"]
    WSGW --> REDIS
    TASKS --> CELERYW["worker"]
    TASKS --> BEAT["beat"]
    CELERYW --> MAIL["SMTP / Mail sender"]
    CELERYW --> RENDER["Renderer (PDF)"]
    CELERYW --> STRIPE["Stripe webhooks"]
    APPCORE --> GOOGLE["Google services"]
    APPCORE --> AI["AI / MCP tools"]
    CELERYW --> DB
    WSGW --> DB
    CELERYW --> REDIS
    APPCORE --> DOCSTATIC["Template + document output"]
